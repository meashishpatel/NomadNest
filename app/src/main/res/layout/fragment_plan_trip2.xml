<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.trip.PlanTripFragment2">

    <!-- Title TextView -->
    <TextView
        android:id="@+id/whenTV"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="@string/when_adventure_title"
        android:textAppearance="@style/press_start"
        android:lineSpacingExtra="0sp"
        android:textAlignment="center"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="45dp" />

    <!-- Choose Date TextView -->
    <TextView
        android:id="@+id/chooseDateTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/chooseDate"
        android:textAppearance="@style/getstartedwithplan"
        android:lineSpacingExtra="3sp"
        android:translationY="-1.53sp"
        android:layout_marginTop="20dp"
        android:gravity="top"
        app:layout_constraintTop_toBottomOf="@id/whenTV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="45dp" />

    <!-- Date Range TextView -->
    <TextView
        android:id="@+id/dateRangeTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select your travel dates"
        android:textSize="16dp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/chooseDateTV"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="45dp" />

    <!-- Calendar View -->

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/calendarLottie"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="24dp"
        app:lottie_rawRes="@raw/date_picker"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:layout_constraintTop_toBottomOf="@id/dateRangeTV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/calendarView"/>

    <FrameLayout
        android:id="@+id/calendarView"
        android:layout_width="343dp"
        android:layout_height="48dp"
        android:background="@drawable/blue_btn_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/nextbtn"
        android:layout_marginBottom="50dp">

        <!-- Nested ConstraintLayout containing the "Next" TextView -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Next Button Text -->
            <TextView
                android:id="@+id/chooseDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick Date"
                android:textAppearance="@style/text_button_login"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>





    <!-- Next Button FrameLayout -->
    <FrameLayout
        android:id="@+id/nextbtn"
        android:layout_width="343dp"
        android:layout_height="48dp"
        android:background="@drawable/grey_btn_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="100dp">

        <!-- Nested ConstraintLayout containing the "Next" TextView -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Next Button Text -->
            <TextView
                android:id="@+id/nextText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next"
                android:textAppearance="@style/welcome_to_"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
